# Хост базы данных (для локальной разработки: localhost, для Docker: postgres)
POSTGRES_HOST=postgres

# Порт PostgreSQL
POSTGRES_PORT=5432

# Имя пользователя БД
# Рекомендация: не используйте 'postgres' в продакшене
POSTGRES_USER=postgres

# Пароль базы данных
# ТРЕБОВАНИЯ: минимум 16 символов, буквы + цифры + спецсимволы
# Генерация: openssl rand -base64 32
POSTGRES_PASSWORD=<GENERATE_YOUR_OWN_STRONG_PASSWORD>

# Имя базы данных
POSTGRES_DB=survey_service

# -------------------------------------------
# JWT Authentication
# -------------------------------------------
# Секретный ключ для JWT
# ТРЕБОВАНИЯ: минимум 32 символа, криптографически случайный
# Генерация: openssl rand -hex 32
# Генерация (Python): python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<GENERATE_YOUR_OWN_SECRET_KEY_MIN_32_CHARS>

# Алгоритм шифрования JWT
ALGORITHM=HS256

# Время жизни токена доступа (в минутах)
# 10080 = 7 дней
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# -------------------------------------------
# Application URLs
# -------------------------------------------
# Базовый URL приложения (для продакшена укажите реальный домен)
# Примеры:
#   Локально: http://localhost:8080
#   Продакшен: https://your-domain.com
BASE_URL=http://localhost:8080